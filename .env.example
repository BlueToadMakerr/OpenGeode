# --- General ---
ENV=development
BASE_URL=http://localhost:3000

# --- GitHub OAuth app (create one at https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/v1/login/github/callback

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Device flow ---
DEVICE_FLOW_EXPIRE_SECONDS=900
DEVICE_FLOW_POLL_INTERVAL=5

# --- Storage (all relative to the working directory the app is run from) ---
DATABASE_DIR=database
# The actual database. A plain SQLite file -- no separate DB server needed,
# just make sure this path is on a persistent volume in production.
DATABASE_SQLITE_FILE=database/database.sqlite3
# Legacy: only read once, to migrate data from before the SQLite storage
# engine if this file exists and DATABASE_SQLITE_FILE doesn't yet. Renamed
# to database.json.migrated afterward. Safe to leave as-is on a fresh setup.
DATABASE_FILE=database/database.json
MODS_STORAGE_DIR=database/mods_storage
LOGOS_DIR=database/mods_storage/logos
ATTACHMENTS_DIR=database/mods_storage/attachments

# --- Uploads ---
MAX_ATTACHMENT_SIZE_BYTES=8388608
MAX_ATTACHMENTS_PER_COMMENT=5
MAX_GEODE_FILE_SIZE_BYTES=67108864

# --- Pagination ---
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# --- Admin bootstrap ---
# Comma-separated GitHub usernames that get admin+verified automatically on
# their first login. Handy for standing up a fresh index.
BOOTSTRAP_ADMINS=
