# --- General ---
ENV=development
BASE_URL=http://localhost:3000

# --- GitHub OAuth app (create one at https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/v1/login/github/callback

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Geometry Dash login-code authentication ---
# Set true to allow signed-in website users to generate 4-character
# one-minute codes for logging into the OpenGeode Geode mod.
ALLOW_GD_LOGIN=false
GD_LOGIN_CODE_EXPIRE_SECONDS=60

# --- Device flow ---
DEVICE_FLOW_EXPIRE_SECONDS=900
DEVICE_FLOW_POLL_INTERVAL=5

# --- Storage (all relative to the working directory the app is run from) ---
DATABASE_DIR=database
DATABASE_SQLITE_FILE=database/database.sqlite3
DATABASE_FILE=database/database.json
MODS_STORAGE_DIR=database/mods_storage
LOGOS_DIR=database/mods_storage/logos
ATTACHMENTS_DIR=database/mods_storage/attachments

# --- Attachment Permissions ---
# Controls who can upload attachments to submission comments.
# 1 = Full: anyone who can comment can upload attachments.
# 2 = Verified: only admins and verified developers can upload attachments.
# 3 = Approved Developers: admins and developers with at least one approved mod can upload attachments.
# 4 = Admins Only: only admins can upload attachments.
# 5 = Off: attachment uploads are completely disabled.
ATTACHMENT_PERMISSIONS=1

# --- Uploads ---
MAX_ATTACHMENT_SIZE_BYTES=8388608
MAX_ATTACHMENTS_PER_COMMENT=5
MAX_GEODE_FILE_SIZE_BYTES=67108864

# --- Pagination ---
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# --- Admin bootstrap ---
BOOTSTRAP_ADMINS=
